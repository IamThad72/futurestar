{
  "name": "futurestar",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "migrate": "node scripts/run-migrations.mjs",
    "seed:exercises": "node scripts/seed-exercise-catalog.mjs",
    "seed:usda": "node scripts/seed-usda-foundation.mjs",
    "seed:usda:branded": "node scripts/seed-usda-branded.mjs",
    "seed:usda:compact": "node scripts/seed-usda-branded.mjs --compact",
    "seed:cpdv": "node scripts/seed-cpdv.mjs",
    "seed:liturgical": "node scripts/seed-liturgical-calendar.mjs",
    "seed:demo": "node scripts/seed-demo-account.mjs",
    "build:mobile": "npm run build:mobile:dev",
    "build:mobile:prod": "node scripts/validate-mobile-env.mjs && cross-env NODE_ENV=production NUXT_MOBILE_PRODUCTION=true NUXT_CAPACITOR=true nuxt generate && node scripts/verify-mobile-dist.mjs",
    "build:mobile:dev": "node scripts/validate-mobile-env.mjs --dev && cross-env CAPACITOR_DEV=true NUXT_CAPACITOR=true nuxt generate && node scripts/verify-mobile-dist.mjs",
    "cap:clean": "node scripts/clean-mobile-artifacts.mjs",
    "cap:deploy:prod": "node scripts/clean-mobile-deploy.mjs",
    "cap:sync": "npm run build:mobile:prod && npx cap sync",
    "cap:sync:dev": "npm run build:mobile:dev && cross-env CAPACITOR_DEV=true npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "cap:run:android": "npm run cap:sync:dev && cross-env CAPACITOR_DEV=true npx cap run android",
    "cap:refresh:android": "node scripts/refresh-android.mjs",
    "cap:run:android:live": "node scripts/warn-skip-sync.mjs && cross-env CAPACITOR_DEV=true npx cap run android --no-sync",
    "cap:run:ios": "npm run cap:sync:dev && cross-env CAPACITOR_DEV=true npx cap run ios",
    "assets:generate": "node scripts/generate-app-assets.mjs",
    "cap:assets": "npm run assets:generate && npx @capacitor/assets generate --assetPath resources --iconBackgroundColor '#06b6d4' --splashBackgroundColor '#fafafa'"
  },
  "dependencies": {
    "@azure/cosmos": "^4.9.0",
    "@capacitor/android": "8.3.4",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.4",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.3.4",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@ionic/core": "^8.7.4",
    "@ionic/vue": "^8.7.4",
    "@nuxtjs/ionic": "^1.0.2",
    "@pinia/nuxt": "^0.11.3",
    "@supabase/supabase-js": "^2.99.1",
    "@unovis/ts": "1.6.7",
    "@unovis/vue": "^1.6.7",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "ionicons": "^8.0.13",
    "mongodb": "^7.0.0",
    "nuxt": "^4.5.2",
    "nuxt-headlessui": "^1.2.2",
    "p-limit": "^7.2.0",
    "pg": "^8.17.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.26",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.3.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/pg": "^8.16.0",
    "cross-env": "^7.0.3",
    "daisyui": "^5.5.14",
    "playwright": "^1.49.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.18"
  }
}
